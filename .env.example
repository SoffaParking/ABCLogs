# Copy to .env for local development (`pnpm dev` reads it). Never commit a real .env.
# Matches the Postgres from `pnpm db:up` (docker-compose.yml, host port 5433).
DATABASE_URL=postgres://apiloupe:apiloupe@localhost:5433/apiloupe
PORT=8080
LOG_LEVEL=info
# A fixed code for first-run setup instead of a random one in the log.
# SETUP_CODE=DEV-SETUP-CODE

# For `pnpm test`: a Postgres user that may create and drop databases. Each
# test file makes its own throwaway database. Unset, the database tests skip.
# TEST_DATABASE_URL=postgres://apiloupe:apiloupe@localhost:5433/postgres

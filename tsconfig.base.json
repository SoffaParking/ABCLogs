{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // TypeScript 6 loads no global type packages unless listed. Everything but
    // the dashboard (which lists its own) runs on Node.
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    // Workspace packages export their TypeScript source under the `source`
    // condition, so tests and `tsx` read src/ directly and only published or
    // Docker builds use dist/.
    "customConditions": ["source"]
  }
}

{
  "name": "apiloupe",
  "version": "1.2.0",
  "private": true,
  "description": "Self-hosted API request and error dashboard: request volume, latency, severity breakdown and grouped errors.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @apiloupe/server --filter @apiloupe/ui dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter \"!@apiloupe/e2e\" test",
    "db:up": "docker compose up -d db",
    "import-logs": "tsx --conditions=source packages/importer/src/cli.ts",
    "demo": "tsx --conditions=source packages/importer/src/cli.ts --demo",
    "test:e2e": "pnpm --filter @apiloupe/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "tsx": "4.23.15"
  }
}
